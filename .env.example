# Copy to .env in the checkout root. Never commit actual tokens.
# Existing process environment values take precedence over .env values.
AUTO_FIX_TEAMCITY_TOKEN=replace-with-teamcity-read-token
AUTO_FIX_BITBUCKET_TOKEN=replace-with-bitbucket-token
AUTO_FIX_JIRA_TOKEN=replace-with-jira-read-token
AUTO_FIX_LLM_TOKEN=replace-with-your-custom-api-token
